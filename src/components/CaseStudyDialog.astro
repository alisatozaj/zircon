---
import { projects } from "../data/work";
---

<dialog id="case-study" class="dialog">
  <button class="close" type="button" data-close-study aria-label="Close">
    <span aria-hidden="true">×</span>
  </button>

  <div class="sheet" data-sheet>
    {
      projects.map((project) => {
        if (project.category === "branding") {
          const images = project.images ?? [];
          return (
            <section class="study brand" data-study={project.slug} data-title={project.title} hidden>
              <header class="head">
                <div class="text">
                  <p class="kicker">{project.kind ?? "Brand identity"}</p>
                  <h2>{project.title}</h2>
                  {project.tagline && <p class="tagline">{project.tagline}</p>}
                </div>
                <a class="btn" href="#contact" data-close-study>
                  Start a project <span aria-hidden="true">→</span>
                </a>
              </header>

              {images.length > 0 && (
                <div class="viewer" data-gallery>
                  <div class="stage">
                    <img class="main" data-main src={images[0]} alt={`${project.title}, image 1`} />
                    {images.length > 1 && (
                      <>
                        <button class="nav prev" type="button" data-prev aria-label="Previous image">←</button>
                        <button class="nav next" type="button" data-next aria-label="Next image">→</button>
                      </>
                    )}
                  </div>

                  {images.length > 1 && (
                    <div class="thumbs" role="group" aria-label="Choose an image">
                      {images.map((src, i) => (
                        <button
                          class="thumb"
                          type="button"
                          data-thumb={i}
                          data-src={src}
                          data-alt={`${project.title}, image ${i + 1}`}
                          aria-pressed={i === 0 ? "true" : "false"}
                          aria-label={`Show image ${i + 1}`}
                        >
                          <img src={src} alt="" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              )}

              <div class="details">
                <div class="col">
                  <p class="label">About the project</p>
                  <p class="body">{project.description}</p>

                  {project.creative && project.creative.length > 0 && (
                    <div class="creative">
                      <p class="label">Creative direction</p>
                      <ul>
                        {project.creative.map((item) => <li>{item}</li>)}
                      </ul>
                    </div>
                  )}
                </div>

                <div class="col facts">
                  {project.industry && (
                    <div class="fact">
                      <p class="label">Industry</p>
                      <p class="value">{project.industry}</p>
                    </div>
                  )}
                  {project.style && (
                    <div class="fact">
                      <p class="label">Style</p>
                      <p class="value">{project.style}</p>
                    </div>
                  )}
                  {project.palette && project.palette.length > 0 && (
                    <div class="fact">
                      <p class="label">Color palette</p>
                      <ul class="palette">
                        {project.palette.map((color) => (
                          <li>
                            <span class="swatch" style={`background:${color.hex}`}></span>
                            <span class="hex">{color.name ?? color.hex}</span>
                            {color.name && <span class="code">{color.hex}</span>}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </section>
          );
        }

        return (
          <section class="study" data-study={project.slug} data-title={project.title} hidden>
            <header class="head">
              <div class="text">
                <h2>{project.title}</h2>
                <p class="about">{project.description}</p>
                {project.url && (
                  <a class="visit" href={project.url} target="_blank" rel="noopener noreferrer">
                    Visit website ↗
                  </a>
                )}
              </div>
              <a class="btn" href="#contact" data-close-study>
                Start a project <span aria-hidden="true">→</span>
              </a>
            </header>

            {project.desktop && (
              /* Websites: the whole site, desktop + mobile. Scroll inside each frame. */
              <div class:list={["views", { single: !project.mobile }]}>
                <figure class="frame desktop">
                  <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
                  <div class="scroll" tabindex="0" aria-label={`${project.title} desktop website, scrollable`}>
                    <img src={project.desktop} alt={`${project.title} desktop website`} loading="lazy" />
                  </div>
                </figure>
                {project.mobile && (
                  <figure class="frame mobile">
                    <div class="scroll" tabindex="0" aria-label={`${project.title} mobile website, scrollable`}>
                      <img src={project.mobile} alt={`${project.title} mobile website`} loading="lazy" />
                    </div>
                  </figure>
                )}
              </div>
            )}
          </section>
        );
      })
    }
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#case-study");
  const sheet = document.querySelector<HTMLElement>("[data-sheet]");

  if (dialog && sheet) {
    const studies = sheet.querySelectorAll<HTMLElement>("[data-study]");

    const open = (slug: string) => {
      let found = false;
      studies.forEach((study) => {
        const match = study.dataset.study === slug;
        study.hidden = !match;
        if (match) {
          found = true;
          dialog.setAttribute("aria-label", study.dataset.title ?? "Project");
          // start every project at the top of its frames, and on its first image
          study.querySelectorAll<HTMLElement>(".scroll").forEach((el) => (el.scrollTop = 0));
          study.querySelector<HTMLElement>('[data-thumb="0"]')?.click();
        }
      });
      if (!found) return;

      if (!dialog.open) {
        dialog.showModal();
        document.body.style.overflow = "hidden";
      }
      sheet.scrollTo({ top: 0 });
    };

    // Branding gallery: click a thumbnail or the arrows to change the big picture
    sheet.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
      const main = gallery.querySelector<HTMLImageElement>("[data-main]");
      const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-thumb]"));
      if (!main || thumbs.length < 2) return;

      let current = 0;
      const show = (index: number) => {
        current = (index + thumbs.length) % thumbs.length;
        main.src = thumbs[current].dataset.src ?? main.src;
        main.alt = thumbs[current].dataset.alt ?? "";
        thumbs.forEach((thumb, i) => thumb.setAttribute("aria-pressed", String(i === current)));
      };

      thumbs.forEach((thumb, i) => thumb.addEventListener("click", () => show(i)));
      gallery.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
      gallery.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
      gallery.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") show(current - 1);
        if (event.key === "ArrowRight") show(current + 1);
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      const trigger = target?.closest<HTMLElement>("[data-open-study]");
      if (trigger?.dataset.openStudy) open(trigger.dataset.openStudy);
    });

    dialog.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      if (event.target === dialog || target?.closest("[data-close-study]")) dialog.close();
    });

    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });
  }
</script>

<style>
  .dialog {
    width: min(72rem, calc(100% - 1.5rem));
    height: calc(100dvh - 2rem);
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .dialog::backdrop {
    background: rgba(12, 13, 17, 0.6);
    backdrop-filter: blur(8px);
  }

  .sheet {
    height: 100%;
    overflow-y: auto;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: var(--radius-card);
    background: var(--bg-elevated);
    box-shadow: 0 24px 80px rgba(12, 13, 17, 0.3);
  }

  .close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    transition: background-color 0.2s ease;
  }

  .close:hover {
    background: var(--btn-dark-hover);
  }

  .study[hidden] {
    display: none;
  }

  /* Header: title + short description, button on the right */
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-right: 3.25rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .about {
    max-width: 40rem;
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .visit {
    display: inline-block;
    margin-top: 0.75rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .btn {
    align-self: flex-start;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.8rem;
    padding: 0 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background: var(--btn-dark-hover);
  }

  /* The views: desktop + mobile, each one scrolls through the whole website */
  .views {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .frame {
    display: flex;
    flex-direction: column;
    height: min(34rem, 72dvh);
    margin: 0;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--bg-elevated);
    box-shadow: 0 0 0 1px var(--line), 0 10px 40px rgba(20, 24, 40, 0.08);
  }

  .bar {
    flex: none;
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: #f4f6fb;
  }

  .bar i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #d3d7e0;
  }

  .scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    background: #e4e7ef;
    scrollbar-width: thin;
  }

  .scroll img {
    width: 100%;
    height: auto;
  }

  .mobile {
    width: min(19rem, 100%);
    justify-self: center;
    border-radius: 1.75rem;
  }

  /* branding: images stacked inside the frame */
  .pics {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1rem;
  }

  .pics img {
    border-radius: 0.9rem;
    box-shadow: 0 0 0 1px var(--line);
  }

  @media (min-width: 800px) {
    .head {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
      padding-right: 3.5rem;
    }

    .btn {
      margin-top: 0.25rem;
    }
  }

  /* Desktop: the popup fits the screen, frames fill the rest of the height */
  @media (min-width: 900px) {
    .study:not(.brand):not([hidden]) {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .views {
      flex: 1;
      min-height: 20rem;
      grid-template-columns: minmax(0, 1fr) 19rem;
    }

    .views.single {
      grid-template-columns: minmax(0, 1fr);
    }

    .frame {
      height: 100%;
    }

    .mobile {
      width: auto;
      justify-self: stretch;
    }
  }

  /* ---------- Branding popup ---------- */
  .kicker {
    margin-bottom: 0.9rem;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6a6e78;
  }

  .tagline {
    margin-top: 0.6rem;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    letter-spacing: -0.01em;
    color: var(--ink-soft);
  }

  .viewer {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 1.1rem;
    box-shadow: 0 0 0 1px var(--line);
  }

  /* the picture at its real shape: full width, full height, nothing cropped */
  .main {
    display: block;
    width: 100%;
    height: auto;
  }

  .nav {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 4px 16px rgba(20, 24, 40, 0.18);
    font-size: 1.05rem;
    transform: translateY(-50%);
    transition: background-color 0.2s ease;
  }

  .nav:hover {
    background: var(--btn-light-hover);
  }

  .prev {
    left: 0.9rem;
  }

  .next {
    right: 0.9rem;
  }

  .thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .thumb {
    width: 5.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.7rem;
    overflow: hidden;
    background: #e4e7ef;
    box-shadow: 0 0 0 1px var(--line);
    opacity: 0.6;
    transition: opacity 0.2s ease, box-shadow 0.2s ease;
  }

  .thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .thumb:hover {
    opacity: 1;
  }

  .thumb[aria-pressed="true"] {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--ink);
  }

  .details {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .label {
    margin-bottom: 0.9rem;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a8d96;
  }

  .body {
    max-width: 36rem;
    font-size: 1rem;
    line-height: 1.65;
    color: #2b2d33;
  }

  .creative {
    margin-top: 2rem;
  }

  .creative ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .creative li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
  }

  .creative li::before {
    content: "";
    flex: none;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .facts {
    display: grid;
    align-content: start;
  }

  .fact {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .fact:first-child {
    padding-top: 0;
  }

  .fact .label {
    margin-bottom: 0.5rem;
  }

  .value {
    font-size: 1rem;
  }

  .palette {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .palette li {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
  }

  .swatch {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(17, 17, 17, 0.12);
  }

  .hex {
    font-size: 0.78rem;
    font-weight: 600;
  }

  .code {
    margin-top: -0.2rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (min-width: 800px) {
    .details {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
  }
</style>