---
import { services } from "../data/services";
---

<section class="services" id="services">
  <header class="intro">
    <p class="index">01 / Services</p>
    <h2>What we do.</h2>
  </header>

  <ol class="list">
    {
      services.map((service, i) => (
        <li class="row" data-service data-open="false">
          <div class="head" data-service-head>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{service.title}</h3>
            <p class="desc">{service.description}</p>
            <button
              class="toggle"
              type="button"
              aria-expanded="false"
              aria-controls={`service-more-${i}`}
              aria-label={`Show what's included in ${service.title}`}
            >
              <span aria-hidden="true">+</span>
            </button>
          </div>

          <div class="more" id={`service-more-${i}`}>
            <div class="more-inner">
              <p class="more-label">Includes</p>
              <ul>
                {service.includes.map((item) => (
                  <li>
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                      <path
                        d="M3 8.5l3.2 3.2L13 4.8"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
              <a class="more-link" href="#pricing">See pricing <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-service]").forEach((row) => {
    const head = row.querySelector<HTMLElement>("[data-service-head]");
    const button = row.querySelector<HTMLButtonElement>(".toggle");
    if (!head || !button) return;

    head.addEventListener("click", () => {
      const open = row.dataset.open !== "true";
      row.dataset.open = String(open);
      button.setAttribute("aria-expanded", String(open));
    });
  });
</script>

<style>
  .services {
    width: min(var(--content), calc(100% - 2 * var(--page-pad)));
    margin: 0 auto;
    padding: var(--section-space) 0 0;
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .index {
    font-family: var(--font-label);
    font-size: 0.64rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6a6e78;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.4rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(17, 17, 17, 0.3);
  }

  .row {
    border-bottom: 1px solid var(--line);
  }

  /* Mobile: stacked */
  .head {
    display: grid;
    grid-template-columns: 1fr 2.4rem;
    grid-template-areas:
      "num num"
      "title toggle"
      "desc desc";
    gap: 0.6rem 1rem;
    padding: 1.6rem 0;
    cursor: pointer;
  }

  .num {
    grid-area: num;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: #8a8d96;
  }

  h3 {
    grid-area: title;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .desc {
    grid-area: desc;
    max-width: 22rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #2b2d33;
  }

  .toggle {
    grid-area: toggle;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid rgba(17, 17, 17, 0.4);
    border-radius: 50%;
    background: transparent;
    font-size: 1.3rem;
    line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.3s ease;
  }

  .head:hover .toggle {
    background: var(--btn-light-hover);
    border-color: rgba(17, 17, 17, 0.5);
  }

  .row[data-open="true"] .toggle {
    transform: rotate(45deg);
  }

  /* Expandable panel (animates height with the grid-rows trick) */
  .more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;
  }

  .row[data-open="true"] .more {
    grid-template-rows: 1fr;
  }

  .more-inner {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .row[data-open="true"] .more-inner {
    opacity: 1;
    transition-delay: 0.1s;
  }

  .more-label {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8d96;
  }

  .more ul {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .more li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
  }

  .more-link {
    display: inline-block;
    margin-bottom: 2rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }

    .head {
      grid-template-columns: 6.5rem minmax(0, 1fr) minmax(0, 21rem) 2.4rem;
      grid-template-areas: "num title desc toggle";
      column-gap: 1.5rem;
      align-items: start;
      padding: 2.1rem 0;
    }

    .num {
      padding-top: 0.9rem;
    }

    .desc {
      padding-top: 0.55rem;
    }

    .more-inner {
      padding-left: 8rem;
    }

    .more ul {
      grid-template-columns: repeat(2, minmax(0, 18rem));
      gap: 0.7rem 2rem;
    }
  }
</style>