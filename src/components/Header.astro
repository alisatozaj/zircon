---
import { navLinks } from "../data/nav";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="nav">
  <a class="brand" href="/" aria-label="Zircon home">
    <img src="/logo.svg" alt="" width="28" height="28" />
    <span>Zircon</span>
  </a>

  <nav class="links" data-nav-links aria-label="Primary">
    {
      navLinks.map((link) => (
        <a href={link.href} aria-current={link.href === path ? "page" : undefined}>{link.label}</a>
      ))
    }
  </nav>

  <div class="end">
    <a class="cta" href="/#contact">Start a project</a>
    <button
      class="menu"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<nav class="drawer" id="mobile-nav" data-nav-drawer hidden>
  {
    navLinks.map((link) => (
      <a href={link.href} aria-current={link.href === path ? "page" : undefined}>{link.label}</a>
    ))
  }
  <a class="cta" href="/#contact">Start a project</a>
</nav>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const drawer = document.querySelector("[data-nav-drawer]");

  if (toggle instanceof HTMLButtonElement && drawer instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(drawer.hidden);
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    z-index: 50;
    top: 1.1rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(70rem, calc(100% - 1.5rem));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0.5rem 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-nav);
    backdrop-filter: blur(22px) saturate(1.6);
    -webkit-backdrop-filter: blur(22px) saturate(1.6);
  }

  .brand img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .links {
    display: none;
    align-items: center;
    gap: 1.65rem;
  }

  .links a {
    position: relative;
    padding: 0.35rem 0;
    font-size: 0.92rem;
    font-weight: 500;
    color: #2b2d33;
    transition: color 0.2s ease;
  }

  /* underline that draws in from the left on hover / keyboard focus */
  .links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s ease;
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--ink);
  }

  .links a:hover::after,
  .links a:focus-visible::after,
  .links a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.55rem;
    padding: 0 1.05rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .cta:hover {
    background: var(--btn-dark-hover);
  }

  .menu {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.55rem;
    height: 2.55rem;
    border: 0;
    background: transparent;
    padding: 0;
  }

  .menu span {
    display: block;
    width: 16px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--ink);
  }

  .drawer {
    position: fixed;
    z-index: 40;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: 6rem 2rem 2rem;
    background: rgba(244, 246, 251, 0.92);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer a {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .drawer .cta {
    width: fit-content;
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }

  @media (min-width: 880px) {
    .links {
      display: flex;
    }

    .menu,
    .drawer {
      display: none;
    }
  }

  @media (max-width: 879px) {
    .nav {
      grid-template-columns: 1fr auto;
    }

    .nav .cta {
      display: none;
    }
  }
</style>