---
import { contacts } from "../data/contact";
import { navLinks } from "../data/nav";
import { services } from "../data/services";
import ContactIcon from "./ContactIcon.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <div class="top">
      <div class="brand-col">
        <a class="brand" href="/#top" aria-label="Zircon home">
          <img class="mark" src="/logo.svg" alt="" width="34" height="34" />
          <span>Zircon</span>
        </a>
        <p class="tagline">Independent design and technology.</p>
        <p class="blurb">Websites, branding and digital work, made with care for small and growing businesses.</p>
      </div>

      <nav class="col" aria-label="Footer">
        <h3>Navigate</h3>
        <ul>
          {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <div class="col">
        <h3>Services</h3>
        <ul>
          {services.map((service) => <li><a href="/#services">{service.title}</a></li>)}
        </ul>
      </div>

      <div class="col">
        <h3>Contact</h3>
        <ul>
          {
            contacts.map((item) => (
              <li>
                <a class="with-icon" href={item.href} aria-label={item.label}>
                  <ContactIcon name={item.icon} />
                  <span>{item.value}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="bottom">
      <p>© {year} Zircon. All rights reserved.</p>
      <div class="legal">
        <a href="/privacy">Privacy</a>
        <a href="#top">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-dark);
    color: #fff;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .inner {
    width: min(var(--content), calc(100% - 2 * var(--page-pad)));
    margin: 0 auto;
  }

  .top {
    display: grid;
    gap: 2.5rem;
    padding: clamp(3.5rem, 7vw, 5rem) 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mark {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  .tagline {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .blurb {
    max-width: 20rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
  }

  h3 {
    margin: 0 0 1.1rem;
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
  }

  .col a,
  .col span {
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s ease;
  }

  .col a:hover,
  .bottom a:hover {
    color: #fff;
  }

  .with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  a:focus-visible {
    outline-color: #fff;
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-label);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .legal {
    display: flex;
    gap: 1.75rem;
  }

  .bottom a {
    transition: color 0.2s ease;
  }

  @media (min-width: 560px) {
    .top {
      grid-template-columns: repeat(2, 1fr);
    }

    .brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .top {
      grid-template-columns: 1.6fr 1fr 1.2fr 1.2fr;
      gap: 3rem;
    }

    .brand-col {
      grid-column: auto;
    }
  }
</style>