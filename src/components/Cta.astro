---
import { contacts } from "../data/contact";
import ContactIcon from "./ContactIcon.astro";
import ContactForm from "./ContactForm.astro";
---

<section class="cta" id="contact">
  <div class="inner">
    <div class="intro">
      <p class="eyebrow">Start here</p>
      <h2>Have something in mind?</h2>
      <p class="sub">Tell us a little about it, and we'll reply with a clear next step.</p>

      <ul class="direct" aria-label="Contact">
        {
          contacts.map((item) => (
            <li>
              <a href={item.href} aria-label={item.label}>
                <ContactIcon name={item.icon} />
                <span>{item.value}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <ContactForm />
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: var(--section-space) var(--page-pad);
    background: var(--bg-dark);
    color: #fff;
  }

  /* a very soft, faded light-blue glow in the center */
  .cta::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 50% 55% at 50% 50%,
      rgba(140, 203, 255, 0.15),
      transparent 70%
    );
  }

  .inner {
    position: relative;
    display: grid;
    gap: 3rem;
    width: min(var(--content), 100%);
    margin: 0 auto;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    font-family: var(--font-label);
    font-size: 0.64rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6.5vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .sub {
    max-width: 24rem;
    margin-top: 1.5rem;
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    color: rgba(255, 255, 255, 0.72);
  }

  .direct {
    display: grid;
    gap: 0.9rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .direct a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.2s ease;
  }

  .direct a:hover {
    color: #fff;
  }

  .direct a:focus-visible {
    outline-color: #fff;
  }

  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1fr 1.05fr;
      gap: 5rem;
      align-items: start;
    }
  }
</style>