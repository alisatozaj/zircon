---
import WorkMarquee from "./WorkMarquee.astro";
---

<section class="hero" id="hero">
  <div class="glow" aria-hidden="true"></div>

  <div class="copy">
    <p class="eyebrow">Design & Technology Studio</p>
    <h1>Make Your Business the<br />Obvious Choice</h1>
    <p class="lede">
      Websites, branding, and digital experiences designed to attract
      customers, build trust, and help your business grow.
    </p>
    <div class="actions">
      <a class="btn primary" href="#contact">Start a project <span aria-hidden="true">→</span></a>
      <a class="btn ghost" href="#work">See the work</a>
    </div>
  </div>

  <WorkMarquee />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: calc(var(--header-height) + 3.5rem) 0 2.5rem;
    background: var(--bg-hero);
  }

  .glow {
    pointer-events: none;
    position: absolute;
    inset: -10% 0 30%;
    background:
      radial-gradient(42% 38% at 18% 28%, rgba(255, 176, 210, 0.55), transparent 70%),
      radial-gradient(38% 34% at 78% 18%, rgba(170, 220, 255, 0.55), transparent 68%),
      radial-gradient(36% 32% at 62% 62%, rgba(255, 228, 150, 0.42), transparent 70%),
      radial-gradient(30% 28% at 12% 72%, rgba(186, 255, 214, 0.32), transparent 70%);
    filter: blur(8px);
  }

  .copy {
    position: relative;
    z-index: 1;
    width: min(52rem, calc(100% - 2 * var(--page-pad)));
    margin: 0 auto 4.5rem;
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 1.6rem;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #3a3d44;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 5.35rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
    color: #141414;
  }

  .lede {
    max-width: 34rem;
    margin: 1.5rem auto 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .primary {
    background: var(--ink);
    color: #fff;
    transition: background-color 0.2s ease;
  }

  .primary:hover {
    background: var(--btn-dark-hover);
  }

  .ghost {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(17, 17, 17, 0.12);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .ghost:hover {
    background: var(--btn-light-hover);
    border-color: rgba(17, 17, 17, 0.2);
  }

  @media (max-width: 640px) {
    h1 br {
      display: none;
    }
  }
</style>